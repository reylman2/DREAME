ARG COMFYUI_BASE_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
FROM ${COMFYUI_BASE_IMAGE}

ARG UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

WORKDIR /workspace/ComfyUI

RUN sed -i "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g; /jammy-backports/d" /etc/apt/sources.list \
  && apt-get -o Acquire::Retries=5 update \
  && apt-get -o Acquire::Retries=5 install -y --no-install-recommends g++ libxcb1 libgl1 libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/comfyui-requirements.txt
RUN grep -Ev '^(torch|torchvision|torchaudio|comfyui-workflow-templates)([<=>[:space:]]|$)' /tmp/comfyui-requirements.txt > /tmp/comfyui-requirements-runtime.txt \
  && python -m pip install --prefer-binary --timeout 120 -r /tmp/comfyui-requirements-runtime.txt

RUN python -m pip install --prefer-binary --timeout 120 \
  opencv-python-headless \
  gfpgan \
  facexlib \
  onnxruntime \
  insightface==0.7.3 \
  && python - <<'PY'
from pathlib import Path

path = Path("/opt/conda/lib/python3.11/site-packages/basicsr/data/degradations.py")
text = path.read_text()
text = text.replace(
    "from torchvision.transforms.functional_tensor import rgb_to_grayscale",
    "from torchvision.transforms.functional import rgb_to_grayscale",
)
path.write_text(text)
PY

EXPOSE 8188

CMD ["python", "-u", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
