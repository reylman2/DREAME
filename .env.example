DATABASE_URL=postgres://dreamehub:dreamehub_password@localhost:15432/dreamehub
DATABASE_SSL=false
NODE_ENV=production
SESSION_TTL_HOURS=720
MAX_UPLOAD_MB=50
MAX_REQUEST_BODY_MB=10
ENABLE_TEST_PAYMENT=false
ACCESS_LOG_ENABLED=true

# Cloudflare R2 object storage (uploads, generated outputs, and static media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Public delivery URL. Defaults to PUBLIC_BASE_URL/r2 and avoids client access to r2.dev.
R2_DELIVERY_BASE_URL=
R2_ALLOWED_ORIGINS=https://app.dreameac.org,https://dreameac.org,https://www.dreameac.org,http://localhost:3000,http://127.0.0.1:3000
R2_PRESIGN_TTL_SECONDS=900
R2_GC_MIN_AGE_HOURS=24
R2_PROXY=
VERIFICATION_DEV_MODE=false

OPENAI_API_KEY=你的 OpenAI API Key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_PROXY=http://127.0.0.1:7890
SMTP_PROXY=http://127.0.0.1:7890
# 可选：公网隧道/外部请求代理。按本机代理端口调整。
PUBLIC_TUNNEL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
OPENAI_IMAGE_MODEL=gpt-image-2
PORT=3000

# 可选：OpenAI-compatible 多渠道 API 中转。
# baseUrl 请包含上游的 /v1；模型映射格式为 "对外模型名": "上游模型名"。
# 推荐使用 apiKeyEnv 引用独立环境变量，不要把真实密钥直接写进 JSON。
API_RELAY_TIMEOUT_MS=120000
API_RELAY_MAX_RETRIES=2
API_RELAY_CHANNELS_JSON=[]

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
API_KEY_ENCRYPTION_SECRET=请替换为至少32位随机字符串
# 国内代表性 OpenAI-compatible 渠道；配置后模型会从“待配置”变为“可用”。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# 火山方舟文本模型通常使用推理接入点 ID，由控制台创建后填写。
ARK_API_KEY=
ARK_TEXT_MODEL=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
# 示例：
# SILICONFLOW_API_KEY=
# API_RELAY_CHANNELS_JSON=[{"id":"siliconflow","name":"SiliconFlow","baseUrl":"https://api.siliconflow.cn/v1","apiKeyEnv":"SILICONFLOW_API_KEY","priority":10,"capabilities":["chat","embeddings"],"modelMap":{"deepseek-chat":"deepseek-ai/DeepSeek-V3","bge-m3":"BAAI/bge-m3"}}]

# Commercial Skill Workflow Agent
# auto = 优先本地模型，失败后回退 OpenAI/免费文本模型；local = 只走本地；openai = 只走 OpenAI。
COMMERCIAL_AGENT_PROVIDER=auto
# Ollama 示例：http://127.0.0.1:11434/v1
# LM Studio 示例：http://127.0.0.1:1234/v1
# vLLM 示例：http://127.0.0.1:8000/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=google/gemma-4-31b-it:free
LOCAL_LLM_API_KEY=local
LOCAL_LLM_TIMEOUT_MS=600000
LOCAL_LLM_MAX_TOKENS=256

# 可选：Seedance 2.0 视频生成。
# 火山方舟 Ark Key 通常以 ark- 开头；服务端会自动识别并走 Ark 官方接口。
# 如果使用第三方 seedance2.app Key，将 SEEDANCE_PROVIDER 改成 seedance2。
SEEDANCE_PROVIDER=ark
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_BASE_URL=
# 图生视频使用本地上传/生成图片时必须配置公网访问地址。
# 可以用 scripts/start-public-tunnel.sh 生成临时 trycloudflare.com 地址。
PUBLIC_BASE_URL=

# 真实支付：支付宝电脑网站支付 + 微信支付 Native。
# 支付宝异步通知：${PUBLIC_BASE_URL}/api/payments/alipay/notify
# 微信支付异步通知：${PUBLIC_BASE_URL}/api/payments/wechat/notify
PAYMENT_PROVIDER=alipay,wechat
PAYMENT_CURRENCY=cny
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_PEM=
# 最低每 1 算力点售价，低于该价格的旧套餐会被服务端自动抬价，防止亏损。
CREDIT_MIN_CNY=0.12
# 目标毛利率保护，用于根据上游成本计算生成扣点。
CREDIT_MARGIN_RATE=0.35
# 上游成本估算，可按真实账单调整；服务端会据此计算生成扣费。
UPSTREAM_COST_SEEDANCE_720P_5S_CNY=5.6
UPSTREAM_COST_OPENAI_IMAGE_LOW_CNY=0.25
UPSTREAM_COST_OPENAI_IMAGE_MEDIUM_CNY=0.45
UPSTREAM_COST_OPENAI_IMAGE_HIGH_CNY=0.9
UPSTREAM_COST_FREE_IMAGE_CNY=0.08
UPSTREAM_COST_FACE_RESTORE_CNY=0.6
UPSTREAM_COST_FACE_SWAP_CNY=0.8
UPSTREAM_COST_TRAIN_CNY=3

# 可选：视频面部高清修复上游接口。
# 服务端会 POST JSON：{ video, videoName, mimeType, prompt, task, faceRestore, quality, strength }
# 返回 JSON 中需要包含 video_url、url 或 output_url。
# FACE_RESTORE_PROVIDER 可选 custom 或 comfyui。
FACE_RESTORE_PROVIDER=custom
FACE_RESTORE_API_URL=
FACE_RESTORE_API_KEY=

# 可选：ComfyUI GFPGAN 真实人脸修复工作流。
# 在 ComfyUI 里导出 API workflow，并将输入视频文件名写成 {{VIDEO_NAME}}。
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_FACE_RESTORE_WORKFLOW=workflows/comfyui-face-restore-light.json
COMFYUI_FACE_RESTORE_OUTPUT_NODE=
COMFYUI_FACE_SWAP_WORKFLOW=workflows/comfyui-face-swap-light.json
COMFYUI_FACE_SWAP_OUTPUT_NODE=
COMFYUI_TIMEOUT_MS=3600000
DREAMEHUB_FACE_RESTORE_DEVICE=auto
DREAMEHUB_GFPGAN_MODEL=
DREAMEHUB_INSWAPPER_MODEL=
DREAMEHUB_INSIGHTFACE_MODEL=buffalo_l
DREAMEHUB_FACE_SWAP_PROVIDER=CPUExecutionProvider
DREAMEHUB_FACE_SWAP_DET_SIZE=320

# Gmail 个人邮箱。需要 Google App Password，不是网页登录密码。
SMTP_GMAIL_HOST=smtp.gmail.com
SMTP_GMAIL_PORT=465
SMTP_GMAIL_SECURE=true
SMTP_GMAIL_USER=your@gmail.com
SMTP_GMAIL_PASS=your-gmail-app-password
SMTP_GMAIL_FROM="DreameHub <your@gmail.com>"
