      </div>
      <div class="detail-panel">
        <span class="badge">${model.badge}</span>
        <h1>${model.title}</h1>
        <p>${model.description}</p>
        <dl class="spec-list">
          <div><dt>浣滆€?/dt><dd>${model.creator}</dd></div>
          <div><dt>浠锋牸</dt><dd>${model.price}</dd></div>
          <div><dt>鎺堟潈</dt><dd>${model.license}</dd></div>
          <div><dt>璇勫垎</dt><dd>${model.score}</dd></div>
        </dl>
        <div class="tag-row">${model.tags.map((tag) => `<span>${tag}</span>`).join("")}</div>
        <button class="primary-btn" id="useModelBtn" type="button">浣跨敤璇ユā鍨嬪垱浣?/button>
      </div>
    </section>
  `;
  document.querySelector("#useModelBtn").addEventListener("click", () => {
    sessionStorage.setItem("DreameHub_model", model.id);
    if (!requireLogin("#/studio")) return;
    toast("姝ｅ湪鎵撳紑鍒涗綔宸ヤ綔鍙?);
    setRoute("#/studio");
  });
}

async function renderStudio() {
  if (!requireLogin("#/studio")) return;
  await ensureCanvasWorkflowsLoaded();
  if (!state.generationHistoryLoaded) {
    refreshGenerationHistoryCache().catch((error) => toast(error.message));
  }
  const workflow = selectedCanvasWorkflow();
  workflow.links ||= [];
  const selectedNode = selectedCanvasNode(workflow);
  const prompt = selectedNode
    ? nodeComposerPrompt(selectedNode, "")
    : sessionStorage.getItem("DreameHub_prompt") || workflow?.prompt || "";
  const defaultImageModel =
    state.imageModels.find((item) => item.id === "openai:gpt-image-2") ||
    state.imageModels.find((item) => item.id === "openai:gpt-image-1") ||
    state.imageModels.find((item) => item.id === "pollinations:flux") ||
    state.imageModels[0];
  appView.innerHTML = `
    <section class="canvas-workbench" aria-label="鍒涗綔鐢诲竷宸ヤ綔鍙?>
      ${canvasTopbar()}
      <div class="canvas-shell">
        ${canvasSideRail()}
        <div class="infinite-canvas has-workflow">
          <div class="canvas-viewport" style="--canvas-zoom: ${state.canvasZoom}; --canvas-pan-x: ${state.canvasPanX}px; --canvas-pan-y: ${state.canvasPanY}px;">
            ${workflowBoardHtml(workflow, prompt, defaultImageModel)}
          </div>
          ${canvasFixedOverlayHtml(workflow, state.generationHistory)}
          ${nodeComposerHtml(workflow, selectedNode, prompt, defaultImageModel)}
        </div>
        <div class="zoom-dock" aria-label="鐢诲竷缂╂斁">
          <button type="button" data-zoom-action="grid" title="缃戞牸瑙嗗浘">鈱?/button>
          <button type="button" data-zoom-action="fit" title="瀹氫綅">鈱?/button>
          <button class="active" type="button" data-zoom-action="snap" title="鍚搁檮">鈱?/button>
          <button type="button" id="zoomOut">鈭?/button>
          <strong id="zoomValue">${Math.round(state.canvasZoom * 100)}%</strong>
          <button type="button" id="zoomIn">锛?/button>
        </div>
        <div class="canvas-drawer" id="canvasDrawer" ${state.canvasDrawer ? "" : "hidden"}>${canvasDrawerHtml()}</div>
        <div class="canvas-context-menu" id="canvasContextMenu" hidden>
          ${canvasContextMenuHtml()}
        </div>
        <div class="add-node-menu" id="addNodeMenu" hidden>
          <strong>娣诲姞鑺傜偣</strong>
          <button type="button" data-add-node-type="text"><span>鈽?/span><b>鏂囨湰</b></button>
          <button type="button" data-add-node-type="image"><span>鈻?/span><b>鍥剧墖</b><em>娴锋姤銆佸垎闀溿€佽鑹茶璁?/em></button>
          ${supportsAnyVideoGeneration() ? '<button type="button" data-add-node-type="video"><span>鈻?/span><b>瑙嗛</b></button>' : ""}
          <button type="button" data-add-node-type="audio"><span>鈮?/span><b>闊抽</b></button>
          <button type="button" data-add-node-type="script"><span>鈻?/span><b>鑴氭湰锛堝凡鎺ュ叆skill锛?/b></button>
        </div>
        <input id="canvasFileInput" type="file" accept="image/*,audio/*,video/*,.txt,.md" hidden />
      </div>
    </section>
  `;
  bindStudio();
}

function selectedCanvasWorkflow() {
  return currentCanvasWorkflow();
}

function canvasTopbar() {
  const workflow = currentCanvasWorkflow();
  const workflows = canvasWorkflowList();
  const options = workflows
    .map(
      (item) =>
        `<option value="${escapeHtml(item.id)}" ${item.id === state.selectedWorkflowId ? "selected" : ""}>${escapeHtml(item.title || "鏈懡鍚嶅伐浣滄祦")}</option>`,
    )
    .join("");
  return `
    <div class="canvas-topbar">
      <a class="canvas-brand route-link" href="#/">
        <span class="canvas-logo">D</span>
        <strong>DreameHub</strong>
      </a>
      <div class="workflow-switcher">
        <span>${escapeHtml(workflow?.title || "鏈懡鍚嶅伐浣滄祦")}</span>
        <select id="canvasWorkflowSelect" aria-label="鍒囨崲宸ヤ綔娴?>${options}</select>
        <button type="button" id="createCanvasWorkflowBtn" title="鏂板缓宸ヤ綔娴?>锛?/button>
      </div>
      <div class="canvas-actions">
        <a class="credit-pill route-link" href="#/pricing"><span>闄愭椂 37 鎶?/span><strong>浼氬憳鐗规儬37鎶?/strong><em>鉁?${state.user.credits}</em></a>
      </div>
    </div>
  `;
}

function canvasSideRail() {
  return `
    <aside class="canvas-rail" aria-label="鐢诲竷宸ュ叿">
      <button class="rail-add" type="button" id="newWorkflowBtn" title="鏂板缓">锛?/button>
      <button type="button" data-rail-action="workflows" title="宸ヤ綔娴?>鈱?/button>
      <button type="button" data-rail-action="assets" title="绱犳潗">鈼?/button>
      <button type="button" data-rail-action="history" title="鍘嗗彶">鈼?/button>
      <span></span>
      <button type="button" data-rail-action="help" title="甯姪">?</button>
      <button type="button" data-rail-action="support" title="瀹㈡湇">鈽?/button>
    </aside>
  `;
}

function workflowLauncherHtml() {
  return `
    <div class="launcher-center">
      <div class="double-click-hint">鈼?<span>鍙屽嚮鐢诲竷 鑷敱鐢熸垚鑺傜偣</span></div>
      <div class="preset-strip">
        ${canvasWorkflowPresets.slice(0, 4).map(presetCardHtml).join("")}
      </div>
      <div class="preset-grid">
        ${canvasWorkflowPresets.slice(4).map(presetCardHtml).join("")}
      </div>
    </div>
  `;
}

function canvasDrawerHtml() {
  const workflow = currentCanvasWorkflow();
  const drawerTitle =
    {
      workflows: "宸ヤ綔娴侀璁?,
      assets: "绱犳潗搴?,
      history: "鍘嗗彶璁板綍",
      help: "宸ヤ綔鍙板府鍔?,
      params: "鍙傛暟闈㈡澘",
    }[state.canvasDrawer] || "鐢诲竷闈㈡澘";

  if (!state.canvasDrawer) return "";

  if (state.canvasDrawer === "workflows") {
    const savedWorkflows = canvasWorkflowList()
      .map(
        (item) => `
        <button class="${item.id === state.selectedWorkflowId ? "active" : ""}" type="button" data-switch-workflow="${escapeHtml(item.id)}">
          <span>${item.id === state.selectedWorkflowId ? "褰撳墠宸ヤ綔娴? : "宸蹭繚瀛?}</span>
          <strong>${escapeHtml(item.title || "鏈懡鍚嶅伐浣滄祦")}</strong>
        </button>
      `,
      )
      .join("");
    return `
      <div class="drawer-head"><strong>宸ヤ綔娴?/strong><button type="button" data-drawer-close>脳</button></div>
      <button class="drawer-upload" type="button" data-create-workflow>鏂板缓宸ヤ綔娴?/button>
      <div class="drawer-list workflow-saved-list">
        ${savedWorkflows || '<p class="empty-state">鏆傛棤宸蹭繚瀛樺伐浣滄祦銆?/p>'}
      </div>
      <div class="drawer-head drawer-subhead"><strong>鑷敱鑺傜偣</strong></div>
      <div class="drawer-list">
        <button type="button" data-add-node-type="text"><span>鏂囨湰</span><strong>鎵嬪啓鍐呭鎴栫敤妯″瀷鐢熸垚鏂囨湰</strong></button>
        <button type="button" data-add-node-type="image"><span>鍥剧墖</span><strong>鎺ュ叆鏂囨湰鍚庢枃鐢熷浘锛屼篃鍙笂浼犲浘鐗?/strong></button>
        ${supportsAnyVideoGeneration() ? '<button type="button" data-add-node-type="video"><span>瑙嗛</span><strong>鎺ュ叆鏂囨湰鎴栧浘鐗囷紝瀹炵幇鏂囩敓瑙嗛/鍥剧敓瑙嗛</strong></button>' : ""}
        <button type="button" data-add-node-type="audio"><span>闊抽</span><strong>浣滀负鑺傚銆侀煶涔愭垨鎯呯华鍙傝€?/strong></button>
      </div>
    `;
  }

  if (state.canvasDrawer === "assets") {
    return `
      <div class="drawer-head"><strong>${drawerTitle}</strong><button type="button" data-drawer-close>脳</button></div>
      <button class="drawer-upload" type="button" data-asset-action="upload">涓婁紶鍥剧墖 / 闊抽 / 鏂囨。</button>
      <div class="drawer-list">
        ${
          (workflow?.nodes || [])
            .map(
              (node) => `
          <button type="button" data-select-node="${node.id}">
            <span>${node.savedToAssets ? "鎴戠殑绱犳潗" : node.type}</span>
            <strong>${escapeHtml(node.label || node.title)}</strong>
          </button>
        `,
            )
            .join("") ||
          '<p class="empty-state">鍏堟坊鍔犳垨涓婁紶鑺傜偣锛屽啀绠＄悊绱犳潗銆?/p>'
        }
      </div>
    `;
  }

  if (state.canvasDrawer === "history") {
    return `
      <div class="drawer-head"><strong>${drawerTitle}</strong><button type="button" data-drawer-close>脳</button></div>
      <div class="drawer-list history-list" id="drawerHistoryList">${historyHtml(state.generationHistory)}</div>
    `;
  }

  if (state.canvasDrawer === "params") {
    return `
      <div class="drawer-head"><strong>${drawerTitle}</strong><button type="button" data-drawer-close>脳</button></div>
      <div class="drawer-list">
        <label>闀滃ご杩愬姩<select data-param-select="camera"><option>鎽勫儚鏈烘帹杩?/option><option>鐜粫</option><option>鍥哄畾闀滃ご</option></select></label>
        <label>鐢婚潰鑺傚<select data-param-select="pace"><option>鑷劧</option><option>蹇€熷垏鎹?/option><option>鎱㈤暅澶?/option></select></label>
        <label>涓€鑷存€?input type="range" min="0" max="100" value="82" data-param-range="consistency" /></label>
      </div>
    `;
  }

  return `
    <div class="drawer-head"><strong>${drawerTitle}</strong><button type="button" data-drawer-close>脳</button></div>
    <div class="drawer-list">
      <p>鍙屽嚮鑺傜偣鍙紪杈戝唴瀹癸紱鐐瑰嚮杩炵嚎鍔犲彿鍙彃鍏ヨ妭鐐癸紱涓婁紶鎸夐挳鍙浛鎹㈢礌鏉愶紱搴曢儴绠ご浼氳皟鐢ㄧ幇鏈夌敓鎴愭帴鍙ｃ€?/p>
      <p>宸︿笅瑙掓敮鎸佺缉鏀俱€佸畾浣嶅拰鍚搁檮鍒囨崲锛岄《閮ㄥ伐鍏锋爮鏀寔鍒嗕韩銆佷笅杞姐€佸叏灞忓拰鐢诲竷妯″紡鍒囨崲銆?/p>
    </div>
  `;
}

function presetCardHtml(preset) {
  return `
    <button class="preset-card ${preset.accent}" type="button" data-workflow-id="${preset.id}">
      <span>${preset.icon}</span>
      <strong>${preset.title}</strong>
      <small>${preset.subtitle}</small>
    </button>
  `;
}

function workflowBoardHtml(workflow, prompt, defaultImageModel) {
  const nodeHtml = workflow.nodes.length
    ? workflow.nodes
        .map((node, index) => workflowNodeHtml(node, index))
        .join("")
    : "";
  return `
    <div class="workflow-stage" style="--node-count: ${workflow.nodes.length}">
      <div class="workflow-node-layer">
        ${workflowLinksHtml(workflow)}
        ${nodeHtml}
      </div>
    </div>
  `;
}

function canvasFixedOverlayHtml(workflow, generations) {
  return `
    ${
      workflow.nodes.length
        ? ""
        : `<div class="canvas-empty-hint">
      <strong>鍙抽敭绌虹櫧澶勬垨鐐瑰嚮宸︿晶 + 娣诲姞鑺傜偣</strong>
      <span>鏂囨湰鑺傜偣鍙互鎵嬪啓鎴栬皟鐢ㄦā鍨嬶紱鍥剧墖/瑙嗛鑺傜偣浼氳鍙栦笂娓歌繛绾垮唴瀹广€?/span>
    </div>`
    }
    <div class="canvas-history ${state.canvasHistoryOpen ? "open" : ""}">
      <button type="button" id="historyToggle">鐢熸垚鍘嗗彶</button>
      <div id="generationHistory" class="history-list compact-history">${historyHtml(generations)}</div>
    </div>
  `;
}

function nodeComposerHtml(workflow, node, prompt, defaultImageModel) {
  if (!node) return "";
  if (node.type === "text" || node.type === "script")
    return textComposerHtml(workflow, node, node.content || prompt || "");
  if (node.type === "image")
    return imageComposerHtml(
      workflow,
      node,
      nodeComposerPrompt(node, prompt),
      defaultImageModel,
    );
  if (node.type === "video")
    return supportsAnyVideoGeneration()
      ? videoReferenceComposerHtml(
          workflow,
          node,
          nodeComposerPrompt(node, prompt),
          defaultImageModel,
        )
      : unavailableComposerHtml(
          "瑙嗛鐢熸垚",
          state.apiCapabilities?.video?.reason ||
            "褰撳墠鏈帴鍏ョ湡瀹炶棰戠敓鎴?API銆?,
        );
  return assetComposerHtml(workflow, node);
}

function unavailableComposerHtml(title, reason) {
  return `
    <div class="prompt-composer asset-composer">
      <div class="mode-status">
        <strong>${escapeHtml(title)}</strong>
        <span>${escapeHtml(reason)}</span>
      </div>
      <p class="form-hint">璇ュ姛鑳芥病鏈夊搴旂殑鐪熷疄 API锛屽凡闅愯棌鐢熸垚鍙傛暟鍜屾彁浜ゆ寜閽€?/p>
    </div>
  `;
}

function textComposerHtml(workflow, node, prompt) {
  const canGenerateText = supportsAnyTextGeneration();
  const isScript = node.type === "script";
  const modelOptions = isScript
    ? `
            <option value="seedance-prompt-zh" selected>鑴氭湰鍏嶈垂</option>
            <option value="seedance-prompt-zh-openai">鑴氭湰 OpenAI</option>`
    : `
            <option value="dreamehub-free-chat" selected>鏂囨湰鍏嶈垂</option>
            <option value="openai-chat">鏂囨湰 OpenAI</option>`;
  const defaultModel = isScript ? "seedance-prompt-zh" : "dreamehub-free-chat";
  const hint = isScript
    ? `褰撳墠閫変腑銆?{escapeHtml(node.label || node.title)}銆嶃€傝剼鏈妭鐐逛細鎺ュ叆 Seedance 2.0 skill锛岀敓鎴愬垎闀溿€佹椂闂磋酱鍜岃棰戞彁绀鸿瘝銆俙
    : `褰撳墠閫変腑銆?{escapeHtml(node.label || node.title)}銆嶃€傛枃鏈妭鐐瑰彧鍋氭櫘閫氭枃鏈敓鎴愶紝涓嶆帴鍏?Seedance 2.0 skill銆俙;
  return `
    <form class="prompt-composer text-composer" id="generationForm" data-composer-kind="text">
      <div class="composer-assets text-only">
        <div class="composer-node-icon">鈻?sup>${canvasIncomingNodes(node.id).length}</sup></div>
      </div>
      <textarea id="promptInput" rows="4" aria-label="杈撳叆鏂囨湰鍐呭鎴栫敓鎴愭彁绀鸿瘝">${escapeHtml(prompt || "")}</textarea>
      <div class="composer-footer">
        <label class="engine-select">鉁?
          <select id="imageModelSelect">
${modelOptions}
          </select>
        </label>
        <input id="workflowMode" type="hidden" value="text" />
        <input id="workflowEngine" type="hidden" value="${defaultModel}" />
        <span class="composer-spacer"></span>
        <button class="text-tool" type="button" data-composer-action="translate" title="缈昏瘧">鏂嘇</button>
        ${canGenerateText ? '<span class="cost-pill">鉁?6</span><button class="send-btn" id="submitGenerationBtn" type="submit" title="鐢熸垚">鈫?/button>' : ""}
      </div>
      <p class="form-hint" id="imageEngineHint">${canGenerateText ? hint : "褰撳墠鏈帴鍏ョ湡瀹炴枃鏈敓鎴?API锛涙枃鏈妭鐐逛粎鏀寔鎵嬪啓鍜岀紪杈戙€?}</p>
    </form>
  `;
}

function batchOutputEditorHtml(workflow) {
  if (!workflow?.batchOutputs?.length) return "";

  return `
    <div class="batch-output-editor">
      <div class="batch-output-editor-head">
        <strong>鎵归噺杈撳嚭璁剧疆</strong>
        <span>杩欓噷鍙互缂栬緫姣忓紶鍥剧殑鏍囬銆佸昂瀵稿拰 promptSuffix</span>
      </div>

      ${workflow.batchOutputs
        .map(
          (output, index) => `
            <div class="batch-output-item">
              <div class="batch-output-row">
                <label>
                  <span>杈撳嚭鏍囬</span>
                  <input
                    type="text"
                    value="${escapeHtml(output.title || "")}"
                    data-batch-output-index="${index}"
                    data-batch-output-field="title"
                    placeholder="渚嬪锛氫富娴锋姤"
                  />
                </label>

                <label>
                  <span>杈撳嚭灏哄</span>
                  <select
                    data-batch-output-index="${index}"
                    data-batch-output-field="size"
                  >
                    <option value="1024x1536" ${output.size === "1024x1536" ? "selected" : ""}>9:16 路 绔栫増</option>
                    <option value="1536x1024" ${output.size === "1536x1024" ? "selected" : ""}>16:9 路 妯増</option>
                    <option value="1024x1024" ${output.size === "1024x1024" ? "selected" : ""}>1:1 路 鏂瑰浘</option>
                    <option value="auto" ${output.size === "auto" ? "selected" : ""}>鑷姩</option>
                  </select>
                </label>
              </div>

              <label>
                <span>promptSuffix</span>
                <textarea
                  rows="3"
                  data-batch-output-index="${index}"
                  data-batch-output-field="promptSuffix"
                  placeholder="渚嬪锛氳緭鍑轰富娴锋姤 1 寮狅紝绐佸嚭浜у搧涓讳綋锛屾爣棰樺尯鍩熺暀鐧姐€?
                >${escapeHtml(output.promptSuffix || "")}</textarea>
              </label>
            </div>
          `,
        )
        .join("")}
    </div>
  `;
}

function imageComposerHtml(workflow, node, prompt, defaultImageModel) {
  const references = nodeReferenceAssets(node, workflow).filter(
    (asset) => asset.id !== node.id || asset.source || asset.image,
  );
  const hasImageReferences = references.some((asset) => asset.type === "image");
  const imageModels = realImageModels();
  const selectedModel =
    (hasImageReferences
      ? imageModels.find(
          (model) =>
            model.id === state.selectedImageModelId &&
            model.capabilities?.supportsReferenceImage,
        ) ||
        imageModels.find((model) => model.id === "openai:gpt-image-2") ||
        imageModels.find((model) => model.capabilities?.supportsReferenceImage)
      : imageModels.find((model) => model.id === state.selectedImageModelId)) ||
    imageModels.find((model) => model.id === "openai:gpt-image-2") ||
    imageModels.find((model) => model.id === "pollinations:flux") ||
    imageModels[0] ||
    defaultImageModel;
  const capabilities = selectedModel?.capabilities || {};
  const supportedReferences = references.filter(
    (asset) => asset.type !== "image" || capabilities.supportsReferenceImage,
  );
  const unsupportedReferences = references.filter(
    (asset) => asset.type === "image" && !capabilities.supportsReferenceImage,
  );
  const canGenerate = Boolean(selectedModel) && !unsupportedReferences.length;
  const config = composerModeConfig["鏂囩敓鍥?];

  return `
    <form class="prompt-composer image-composer" id="generationForm" data-composer-kind="image">
      <div class="mode-status">
        <strong>${selectedModel?.label || config.engine}</strong>
        <span>${unsupportedReferences.length ? "褰撳墠鐪熷疄鐢熷浘 API 涓嶆敮鎸佸浘鐗囧弬鑰冭緭鍏ワ紱璇风Щ闄ゅ浘鐗囦笂娓革紝鎴栨帴鍏ユ敮鎸佸弬鑰冨浘鐨勬ā鍨嬨€? : "褰撳墠鐪熷疄鎺ュ彛鏀寔鏂囩敓鍥撅紱鍙樉绀鸿鎺ュ彛瀹為檯鏀寔鐨勫弬鏁般€?}</span>
      </div>

      ${
        supportedReferences.length
          ? `<div class="composer-assets">
        ${supportedReferences
          .slice(0, 4)
          .map(
            (asset) =>
              `<button class="asset-token" type="button" data-insert-mention="${asset.refName}">
                ${
                  asset.image
                    ? `<img src="${asset.image}" alt="${escapeHtml(asset.displayName)}" />`
                    : `<strong>${escapeHtml(asset.displayName)}</strong>`
                }
                <span>${escapeHtml(asset.displayName)}</span>
              </button>`,
          )
          .join("")}
      </div>`
          : ""
      }

      ${referencePromptHtml(supportedReferences, prompt)}

      <div class="composer-footer">
        <label class="engine-select">鉁?
          <select id="imageModelSelect">
            ${imageModels
              .map(
                (model) =>
                  `<option value="${model.id}" ${model.id === selectedModel?.id ? "selected" : ""}>${model.label}</option>`,
              )
              .join("")}
          </select>
        </label>

        ${imageSettingControls(selectedModel)}

        <span class="composer-spacer"></span>

        <button class="text-tool" type="button" data-composer-action="translate" title="缈昏瘧">鏂嘇</button>
        <span class="cost-pill">鉁?${config.cost}</span>
        ${canGenerate ? '<button class="send-btn" id="submitGenerationBtn" type="submit" title="鐢熸垚">鈫?/button>' : ""}
      </div>

      <input id="workflowMode" type="hidden" value="image" />
      <input id="workflowEngine" type="hidden" value="${selectedModel?.id || ""}" />

      <p class="form-hint" id="imageEngineHint">
        ${unsupportedReferences.length ? "宸查殣钘?@鍙傝€冨拰鏍囪绛変笉鏀寔鍔熻兘锛涘綋鍓嶆ā鍨嬩笉浼氭秷璐瑰浘鐗?1銆? : "鐩存帴杈撳叆鐢婚潰鎻忚堪鍗冲彲鐢熸垚鍥剧墖锛涙枃鏈笂娓镐細浣滀负鎻愮ず璇嶆潵婧愩€?}
      </p>
    </form>
  `;
}

