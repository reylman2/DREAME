function requireDatabaseUrl() {
  if (!LOCAL_MEMORY_DB && !process.env.DATABASE_URL) {
    throw new Error(
      "DATABASE_URL is required. PostgreSQL is the only supported runtime database.",
    );
  }
}

function createLocalMemoryDb() {
  return {
    stats: {
      creators: "0",
      models: "0",
      generations: "0",
      uptime: "local",
    },
    users: [],
    sessions: [],
    verificationRequests: [],
    workspaces: [],
    wallets: [],
    apiKeys: [],
    orders: [],
    generations: [],
    models: [],
    workflows: [],
    communityWorks: [],
    plans: [],
    userWorkflows: [],
    commercialVideoChats: [],
  };
}

async function readDb() {
  requireDatabaseUrl();
  if (dbCache) return dbCache;
  if (LOCAL_MEMORY_DB) {
    dbCache = createLocalMemoryDb();
    return dbCache;
  }
  dbCache = await readPostgresDb();
  return dbCache;
}

async function writeDb(db) {
  requireDatabaseUrl();
  if (LOCAL_MEMORY_DB) {
    dbCache = db;
    return;
  }
  await writePostgresDb(db);
  dbCache = db;
}

async function upsertDbItems(collection, items) {
  requireDatabaseUrl();
  if (LOCAL_MEMORY_DB) return;
  await upsertPostgresItems(collection, items);
}

async function checkPostgresHealth() {
  requireDatabaseUrl();
  if (LOCAL_MEMORY_DB) return;
  const db = getPool();
  await db.query("select 1");
}

function sendJson(res, status, payload) {
  res.writeHead(status, {
    "Content-Type": "application/json; charset=utf-8",
    "Cache-Control": "no-store",
  });
  res.end(JSON.stringify(payload));
}

function sendError(res, status, message) {
  sendJson(res, status, { error: message });
}

async function readBody(req) {
  const chunks = [];
  for await (const chunk of req) chunks.push(chunk);
  if (!chunks.length) return {};

  try {
    return JSON.parse(Buffer.concat(chunks).toString("utf8"));
  } catch {
    return null;
  }
}

async function readRawBody(req) {
  const chunks = [];
  for await (const chunk of req) chunks.push(chunk);
  return Buffer.concat(chunks);
}

async function readFormBody(req) {
  const rawBody = await readRawBody(req);
  return Object.fromEntries(new URLSearchParams(rawBody.toString("utf8")));
}

function publicUser(user) {
  if (!user) return null;
  return {
    id: user.id,
    name: user.name,
    email: user.email,
    avatar: user.avatar,
    plan: user.plan,
    credits: user.credits,
    role: user.role,
  };
}

function ensureCollections(db) {
  db.stats ||= {};
  db.stats.creators ||= "0";
  db.stats.models ||= "0";
  db.stats.works ||= "0";
  db.stats.calls ||= "0";
  db.users ||= [];
  db.sessions ||= [];
  db.verificationRequests ||= [];
  db.workspaces ||= [];
  db.wallets ||= [];
  db.apiKeys ||= [];
  db.orders ||= [];
  db.generations ||= [];
  db.userWorkflows ||= [];
  db.models ||= [];
  db.workflows ||= [];
  db.communityWorks ||= [];
  db.plans ||= defaultPlans();
  db.commercialVideoChats ||= [];

  for (const user of db.users) {
    ensureUserInfrastructure(db, user);
  }
}

function ensureUserInfrastructure(db, user) {
  let created = false;
  let workspace = db.workspaces.find((item) => item.ownerId === user.id);
  if (!workspace) {
    workspace = createDefaultWorkspace(user);
    db.workspaces.push(workspace);
    created = true;
  }

  let wallet = db.wallets.find((item) => item.userId === user.id);
  if (!wallet) {
    wallet = createWallet(user, workspace);
    db.wallets.push(wallet);
    created = true;
  }

  return { workspace, wallet, created };
}

function createDefaultWorkspace(user) {
  const projectId = crypto.randomUUID();
  return {
    id: crypto.randomUUID(),
    ownerId: user.id,
    name: `${user.name} 鐨勫伐浣滃尯`,
    slug: `${user.name.toLowerCase().replace(/[^a-z0-9]+/g, "-") || "workspace"}-${Date.now()}`,
    defaultProjectId: projectId,
    projects: [
      {
        id: projectId,
        name: "Default Project",
        environment: "production",
        createdAt: new Date().toISOString(),
      },
    ],
    createdAt: new Date().toISOString(),
  };
}

function createWallet(user, workspace) {
  return {
    id: crypto.randomUUID(),
    userId: user.id,
    workspaceId: workspace.id,
    currency: "CNY",
    balance: 0,
    frozenBalance: 0,
    createdAt: new Date().toISOString(),
  };
}

function safeJsonClone(value, fallback) {
  try {
    const cloned = JSON.parse(JSON.stringify(value ?? fallback));
    return cloned ?? fallback;
  } catch {
    return fallback;
  }
}

function createDefaultUserCanvasWorkflow(user) {
  const now = new Date().toISOString();
  return {
    id: "free-canvas",
    userId: user.id,
    title: "鑷敱鐢诲竷",
    subtitle: "鑷敱娣诲姞鏂囨湰銆佸浘鐗囥€佽棰戜笌闊抽鑺傜偣锛岄€氳繃杩炵嚎鍐冲畾鐢熸垚涓婁笅鏂囥€?,
    icon: "锛?,
    accent: "cyan",
    mode: "free",
    composerKind: "free",
    modelLabel: "鑷敱鑺傜偣",
    cost: 0,
    prompt: "",
